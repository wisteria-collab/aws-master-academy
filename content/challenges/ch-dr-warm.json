  "modelExplanation": "この目標（データは数秒分、停止は数分）は、ウォームスタンバイの目安に当たります。別のリージョンに縮小版の環境を常に動かし、Auroraグローバルデータベースで、データをリージョンをまたいで継続的に非同期で複製します。障害のときは、Amazon Route 53のヘルスチェックによる自動のDNSフェイルオーバーで、利用者を災害対策用のリージョンへ向け、セカンダリのリージョンを昇格します。",
  "relatedTemplateIds": [
    "tpl-dr-warm-standby"
  ],
  "checklist": [
    {
      "id": "c1",
      "label": "リージョンの枠が2つある",
      "rule": {
        "type": "hasGroup",
        "labelIncludes": [
          "リージョン"
        ],
        "min": 2
      },
      "reason": "リージョン全体の障害に備えるには、別のリージョンに環境を用意します。"
    },
    {
      "id": "c2",
      "label": "Amazon Auroraを2つ使っている",
      "rule": {
        "type": "hasService",
        "serviceIds": [
          "amazon-aurora"
        ],
        "min": 2
      },
      "reason": "それぞれのリージョンにデータベースを置きます。"
    },
    {
      "id": "c3",
      "label": "Aurora同士が、線でつながっている",
      "rule": {
        "type": "connected",
        "from": [
          "amazon-aurora"
        ],
        "to": [
          "amazon-aurora"
        ]
      },
      "reason": "Auroraグローバルデータベースは、リージョンをまたいで継続的に非同期で複製します。"
    },
    {
      "id": "c4",
      "label": "アプリケーションのサーバー（EC2）を使っている",
      "rule": {
        "type": "hasService",
        "serviceIds": [
          "amazon-ec2",
          "amazon-ec2-auto-scaling"
        ],
        "min": 2
      },
      "reason": "ウォームスタンバイでは、災害対策用のリージョンでも、縮小版のアプリケーションを常に動かします。"
    },
    {
      "id": "c5",
      "label": "Amazon Route 53を使っている",
      "rule": {
        "type": "hasService",
        "serviceIds": [
          "amazon-route-53"
        ]
      },
      "reason": "Route 53は、ヘルスチェックによる自動のDNSフェイルオーバーに対応します。"
    },
    {
      "id": "c6",
      "label": "Route 53とアプリケーションのサーバーが、線でつながっている",
      "rule": {
        "type": "connected",
        "from": [
          "amazon-route-53"
        ],
        "to": [
          "amazon-ec2",
          "amazon-ec2-auto-scaling"
        ]
      },
      "reason": "利用者の通信は、Route 53が、通常は本番へ、障害のときは災害対策用のリージョンへ向けます。"
    }
  ]
}
