  "modelExplanation": "流れ続けるデータは、Amazon Kinesis Data Streamsで取り込み、Amazon Data FirehoseでS3に届けます。Data Firehoseは、S3に届ける前に、Apache ParquetやApache ORCといった列指向のフォーマットに変換できます。S3にためたデータは、Amazon AthenaでSQLを使って分析し、AWS Glueで変換（ETL）します。AWS Lake Formationは、データをカタログ化し、機密性の高いデータへのアクセスを保護する仕組みを用意します。",
  "relatedTemplateIds": [
    "tpl-data-lake"
  ],
  "checklist": [
    {
      "id": "c1",
      "label": "ストリーミングの取り込み（Kinesis Data Streams）を使っている",
      "rule": {
        "type": "hasService",
        "serviceIds": [
          "amazon-kinesis"
        ]
      },
      "reason": "流れ続けるデータは、ストリーミングのサービスで取り込みます。"
    },
    {
      "id": "c2",
      "label": "Amazon Data Firehoseを使っている",
      "rule": {
        "type": "hasService",
        "serviceIds": [
          "amazon-data-firehose"
        ]
      },
      "reason": "Data Firehoseは、S3に届ける前に、列指向のフォーマットに変換できます。"
    },
    {
      "id": "c3",
      "label": "Data FirehoseとS3が、線でつながっている",
      "rule": {
        "type": "connected",
        "from": [
          "amazon-data-firehose"
        ],
        "to": [
          "amazon-s3"
        ]
      },
      "reason": "変換したデータを、データレイクのS3に届けます。"
    },
    {
      "id": "c4",
      "label": "Amazon Athenaを使い、S3とつながっている",
      "rule": {
        "type": "connected",
        "from": [
          "amazon-athena"
        ],
        "to": [
          "amazon-s3"
        ]
      },
      "reason": "Athenaで、S3のデータをSQLで分析します。"
    },
    {
      "id": "c5",
      "label": "AWS Lake Formationを使っている",
      "rule": {
        "type": "hasService",
        "serviceIds": [
          "aws-lake-formation"
        ]
      },
      "reason": "Lake Formationは、データレイクのデータをカタログ化し、機密性の高いデータへのアクセスを保護します。"
    },
    {
      "id": "c6",
      "label": "まとまったデータ向けの転送サービス（AWS DataSync）だけで取り込んでいない",
      "rule": {
        "type": "notService",
        "serviceIds": [
          "aws-datasync"
        ]
      },
      "reason": "DataSyncは、まとまったデータを移すときのサービスです。流れ続けるデータには、ストリーミングのサービスを使います。"
    }
  ]
}
