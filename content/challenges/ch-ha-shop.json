  "modelExplanation": "EC2インスタンスを2つのアベイラビリティゾーンに配置し、Elastic Load Balancingで通信を分散します。データベースは、Amazon RDSのマルチAZ配置にします。別のアベイラビリティゾーンに同期のスタンバイが維持され、問題が検出されると自動でフェイルオーバーします。アプリケーションとデータベースは、プライベートサブネットに置きます。",
  "relatedTemplateIds": [
    "tpl-ha-web-3tier"
  ],
  "checklist": [
    {
      "id": "c1",
      "label": "アベイラビリティゾーンの枠が、2つ以上ある",
      "rule": {
        "type": "hasGroup",
        "labelIncludes": [
          "アベイラビリティゾーン",
          "AZ"
        ],
        "min": 2
      },
      "reason": "1つのアベイラビリティゾーンの障害に耐えるには、2つ以上のゾーンを使います。"
    },
    {
      "id": "c2",
      "label": "サーバー（EC2）の箱が、2つ以上ある",
      "rule": {
        "type": "hasService",
        "serviceIds": [
          "amazon-ec2",
          "amazon-ec2-auto-scaling"
        ],
        "min": 2
      },
      "reason": "サーバーが1台だけだと、その1台が単一障害点になります。"
    },
    {
      "id": "c3",
      "label": "ロードバランサー（Elastic Load Balancing）を使っている",
      "rule": {
        "type": "hasService",
        "serviceIds": [
          "elastic-load-balancing"
        ]
      },
      "reason": "ロードバランサーが、通信を複数のアベイラビリティゾーンのサーバーに分散します。"
    },
    {
      "id": "c4",
      "label": "ロードバランサーとサーバーが、線でつながっている",
      "rule": {
        "type": "connected",
        "from": [
          "elastic-load-balancing"
        ],
        "to": [
          "amazon-ec2",
          "amazon-ec2-auto-scaling"
        ]
      },
      "reason": "利用者の通信は、ロードバランサーを通ってサーバーに届きます。"
    },
    {
      "id": "c5",
      "label": "データベース（RDSまたはAurora）の箱が、2つ以上ある",
      "rule": {
        "type": "hasService",
        "serviceIds": [
          "amazon-rds",
          "amazon-aurora"
        ],
        "min": 2
      },
      "reason": "マルチAZ配置では、プライマリとは別のアベイラビリティゾーンに、スタンバイが維持されます。図では、2つの箱で表します。"
    },
    {
      "id": "c6",
      "label": "サーバーとデータベースが、線でつながっている",
      "rule": {
        "type": "connected",
        "from": [
          "amazon-ec2",
          "amazon-ec2-auto-scaling"
        ],
        "to": [
          "amazon-rds",
          "amazon-aurora"
        ]
      },
      "reason": "サーバーが、データベースを読み書きします。"
    },
    {
      "id": "c7",
      "label": "データベースが、「プライベート」の枠の中にある",
      "rule": {
        "type": "insideGroup",
        "serviceIds": [
          "amazon-rds",
          "amazon-aurora"
        ],
        "labelIncludes": [
          "プライベート"
        ]
      },
      "reason": "インターネットから直接アクセスされるべきでないものは、プライベートサブネットに置きます。"
    }
  ]
}