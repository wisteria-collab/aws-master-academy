  "modelExplanation": "サーバーは、インターネットゲートウェイへの経路を持たないプライベートサブネットに置きます。外へ出る通信は、パブリックサブネットに置いたNATゲートウェイが取り次ぎます。NATゲートウェイは、外からの接続を開始させません。S3への通信は、ゲートウェイエンドポイントを通します。ゲートウェイエンドポイントに追加の料金はかからず、NATゲートウェイを通るデータを減らせます。",
  "relatedTemplateIds": [
    "tpl-private-egress"
  ],
  "checklist": [
    {
      "id": "c1",
      "label": "パブリックサブネットの枠がある",
      "rule": {
        "type": "hasGroup",
        "labelIncludes": [
          "パブリック"
        ]
      },
      "reason": "NATゲートウェイは、パブリックサブネットに置きます。"
    },
    {
      "id": "c2",
      "label": "プライベートサブネットの枠がある",
      "rule": {
        "type": "hasGroup",
        "labelIncludes": [
          "プライベート"
        ]
      },
      "reason": "インターネットから直接アクセスされるべきでないサーバーは、プライベートサブネットに置きます。"
    },
    {
      "id": "c3",
      "label": "サーバー（EC2）が、プライベートサブネットの中にある",
      "rule": {
        "type": "insideGroup",
        "serviceIds": [
          "amazon-ec2"
        ],
        "labelIncludes": [
          "プライベート"
        ]
      },
      "reason": "プライベートサブネットは、インターネットゲートウェイへの経路を持たないため、外から直接は届きません。"
    },
    {
      "id": "c4",
      "label": "VPCの部品（NATゲートウェイなど）が、パブリックサブネットの中にある",
      "rule": {
        "type": "insideGroup",
        "serviceIds": [
          "amazon-vpc"
        ],
        "labelIncludes": [
          "パブリック"
        ]
      },
      "reason": "外へ出るための取り次ぎ係であるNATゲートウェイは、パブリックサブネットに置きます。"
    },
    {
      "id": "c5",
      "label": "サーバーとVPCの部品が、線でつながっている",
      "rule": {
        "type": "connected",
        "from": [
          "amazon-ec2"
        ],
        "to": [
          "amazon-vpc"
        ]
      },
      "reason": "サーバーからの通信は、NATゲートウェイやゲートウェイエンドポイントを通って外へ出ます。"
    },
    {
      "id": "c6",
      "label": "Amazon S3を使っている",
      "rule": {
        "type": "hasService",
        "serviceIds": [
          "amazon-s3"
        ]
      },
      "reason": "ファイルの保存先です。"
    },
    {
      "id": "c7",
      "label": "VPCの部品（ゲートウェイエンドポイント）とS3が、線でつながっている",
      "rule": {
        "type": "connected",
        "from": [
          "amazon-vpc"
        ],
        "to": [
          "amazon-s3"
        ]
      },
      "reason": "ゲートウェイエンドポイントを通すと、インターネットゲートウェイやNATの装置を使わずにS3へ接続できます。追加の料金はかかりません。"
    }
  ]
}