  "modelExplanation": "大量のデータを一貫した品質で送るには、専用のネットワーク接続のAWS Direct Connectを使います。予備には、既存のインターネット回線で暗号化されたトンネルを張るAWS Site-to-Site VPNを用意します。両方をAWS Transit Gatewayにつなぎ、Transit Gatewayから各VPCへ接続します。VPCピアリングは1対1の接続で、推移的なルーティングに対応しないため、VPCが増えると接続の管理が複雑になります。",
  "relatedTemplateIds": [
    "tpl-hybrid-connect"
  ],
  "checklist": [
    {
      "id": "c1",
      "label": "VPCの枠が2つある",
      "rule": {
        "type": "hasGroup",
        "labelIncludes": [
          "VPC"
        ],
        "min": 2
      },
      "reason": "部署ごとの2つのVPCを表します。"
    },
    {
      "id": "c2",
      "label": "AWS Direct Connectを使っている",
      "rule": {
        "type": "hasService",
        "serviceIds": [
          "aws-direct-connect"
        ]
      },
      "reason": "大量のデータを継続的に、一貫した品質で送るための専用の接続です。"
    },
    {
      "id": "c3",
      "label": "Site-to-Site VPNを使っている",
      "rule": {
        "type": "hasService",
        "serviceIds": [
          "aws-vpn"
        ]
      },
      "reason": "既存のインターネット回線を使う、暗号化された予備の接続です。"
    },
    {
      "id": "c4",
      "label": "AWS Transit Gatewayを使っている",
      "rule": {
        "type": "hasService",
        "serviceIds": [
          "aws-transit-gateway"
        ]
      },
      "reason": "多数のVPCとオンプレミスのネットワークを、中央のハブで接続します。"
    },
    {
      "id": "c5",
      "label": "Direct ConnectとTransit Gatewayが、線でつながっている",
      "rule": {
        "type": "connected",
        "from": [
          "aws-direct-connect"
        ],
        "to": [
          "aws-transit-gateway"
        ]
      },
      "reason": "本社からの専用の接続を、ハブに集めます。"
    },
    {
      "id": "c6",
      "label": "VPNとTransit Gatewayが、線でつながっている",
      "rule": {
        "type": "connected",
        "from": [
          "aws-vpn"
        ],
        "to": [
          "aws-transit-gateway"
        ]
      },
      "reason": "予備の接続も、同じハブに集めます。"
    },
    {
      "id": "c7",
      "label": "Transit GatewayとEC2が、線でつながっている",
      "rule": {
        "type": "connected",
        "from": [
          "aws-transit-gateway"
        ],
        "to": [
          "amazon-ec2"
        ]
      },
      "reason": "ハブから、各VPCのサーバーへ接続します。"
    },
    {
      "id": "c8",
      "label": "EC2がVPCの枠の中にある",
      "rule": {
        "type": "insideGroup",
        "serviceIds": [
          "amazon-ec2"
        ],
        "labelIncludes": [
          "VPC"
        ]
      },
      "reason": "サーバーは、それぞれのVPCの中に置きます。"
    }
  ]
}
